# Copy to .env.local and fill in.
# Supabase → Connect → App Frameworks (never use the service_role / secret key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# https://cloud.maptiler.com/account/keys/ — optional; without it the map falls
# back to the keyless OpenFreeMap style and the satellite toggle is hidden.
NEXT_PUBLIC_MAPTILER_KEY=
